+        for (size_t i = 1; i < d.audio.size(); ++i) {
+            const int64_t step = d.audio[i].pts_us - d.audio[i - 1].pts_us;
+            forward = forward && step > 0;
+            worst = std::max(worst, step);
+        }
+        CHECK(forward);
+        CHECK(worst < 100000);
+    }
+    check_seek("mp.mpd", 7000000, 6000000);  // in the second Period
