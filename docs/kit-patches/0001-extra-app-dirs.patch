diff --git a/CMakeLists.txt b/CMakeLists.txt
index f6b4bde..bcb613b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -78,3 +78,15 @@ if (WNK_BUILD_TESTS)
     enable_testing()
     add_subdirectory(tests)
 endif ()
+
+# Applications kept outside this tree: a ;-separated list of absolute directories, each with its own
+# CMakeLists.txt calling wnk_add_webos_package(). Read from the environment on first configure so
+# tools/test.sh and tools/build-webos.sh need no extra arguments.
+set(WNK_EXTRA_APP_DIRS "$ENV{WNK_EXTRA_APP_DIRS}" CACHE STRING "Out-of-tree application directories")
+if (WNK_EXTRA_APP_DIRS)
+    include(WebOSPackage)
+    foreach (_app_dir IN LISTS WNK_EXTRA_APP_DIRS)
+        get_filename_component(_app_name "${_app_dir}" NAME)
+        add_subdirectory("${_app_dir}" "${CMAKE_BINARY_DIR}/extra-apps/${_app_name}")
+    endforeach ()
+endif ()
